# -----------------------------------------------------------------------------
# BankOps API
# Copy to .env  (cp .env.example .env)
# -----------------------------------------------------------------------------

NODE_ENV=development
LOG_LEVEL=info
API_HOST=0.0.0.0
API_PORT=4000

DATABASE_URL=postgresql://bankops:bankops@localhost:5432/bankops?schema=public

FRONTEND_ORIGIN=http://localhost:3000
JWT_SECRET=replace-with-a-64-char-random-string
JWT_EXPIRES_IN=15m
COOKIE_SECURE=false

# Optional: seed bootstrap operator
SEED_ADMIN_EMAIL=oscar.d@example.net
SEED_ADMIN_PASSWORD=ChangeMe!Admin1
SEED_ADMIN_NAME=Platform Admin

# Incident escalation sweep: how often the in-process scheduler checks
# every active incident against its severity's SLA. Set to 0 to disable
# (e.g. multi-instance deployments driving the sweep from one external
# scheduler instead — see IncidentEscalationService.runSweep).
ESCALATION_SWEEP_INTERVAL_MS=60000
# SLA rollup: how often the current month's SlaRecord is recomputed for
# every service. Same disable-to-0 pattern as the escalation sweep.
SLA_ROLLUP_INTERVAL_MS=3600000
# Reserved service-account user the sweep attributes automated audit
# entries to (see prisma/seed.ts) — every AuditLog row needs a real actor.
SYSTEM_ACTOR_EMAIL=system@bankops.internal
