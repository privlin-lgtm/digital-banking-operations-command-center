# -----------------------------------------------------------------------------
# BankOps Control Center — root environment template
# Copy to .env and adjust. Never commit real secrets.
# -----------------------------------------------------------------------------

NODE_ENV=development
LOG_LEVEL=info

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=bankops
POSTGRES_PASSWORD=bankops
POSTGRES_DB=bankops
DATABASE_URL=postgresql://bankops:bankops@localhost:5432/bankops?schema=public

# API
API_PORT=4000
API_HOST=0.0.0.0
FRONTEND_ORIGIN=http://localhost:3000
JWT_SECRET=replace-with-a-64-char-random-string
JWT_EXPIRES_IN=15m
COOKIE_SECURE=false

# Web
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# Grafana (compose)
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=change-me-grafana
