generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum UserRole {
  ADMIN
  COMMANDER
  RESPONDER
  VIEWER
}

enum ServiceTier {
  TIER_1
  TIER_2
  TIER_3
  TIER_4
}

enum ServiceStatus {
  HEALTHY
  DEGRADED
  CRITICAL
  MAINTENANCE
  UNKNOWN
}

/// How sensitive the data a service touches is, independent of which
/// regulatory regime applies (that's complianceScope) — a service can be
/// RESTRICTED without being PCI-DSS scoped (e.g. the audit archive), and
/// PCI-DSS scoped without being the most restrictive tier (many PCI
/// controls apply well below RESTRICTED). Two axes, not one, because real
/// compliance reviews ask both questions separately.
enum DataClassification {
  PUBLIC
  INTERNAL
  CONFIDENTIAL
  RESTRICTED
}

enum DependencyType {
  HARD
  SOFT
}

enum Severity {
  SEV1
  SEV2
  SEV3
  SEV4
}

enum AlertState {
  FIRING
  ACKNOWLEDGED
  RESOLVED
}

enum AlertComparator {
  GREATER_THAN
  LESS_THAN
}

/// Chaos-engineering scenarios the Failure Simulator can inject. Each maps
/// to a fixed set of synthetic metric names/degradation curves — see
/// FailureScenarioGenerator, the pure class that owns that mapping.
enum FailureScenario {
  DATABASE_OUTAGE
  NETWORK_LATENCY
  MEMORY_LEAK
  CPU_SPIKE
  SERVICE_DEGRADATION
  THIRD_PARTY_API_FAILURE
}

/// The six narrative archetypes Demo Mode cycles through — deliberately the
/// same six the six-month seed history's flagship incidents use (see
/// prisma/seed-history/narrative.ts), each pinned to the one real
/// AlertRule/service pair that already has live thresholds, so a demo run
/// fires a genuine alert, not a fabricated one. See modules/demo-mode.
enum DemoScenario {
  DATABASE_OUTAGE
  DEPENDENCY_FAILURE
  LATENCY_SPIKE
  DEPLOYMENT_FAILURE
  MEMORY_LEAK
  THIRD_PARTY_OUTAGE
}

/// A demo run's position in its own lifecycle. Advanced by DemoModeService's
/// scheduler tick — see that class for what happens at each phase.
enum DemoPhase {
  IDLE
  BASELINE
  DEGRADING
  INCIDENT
  REMEDIATING
  RESOLVED
  RCA_REVIEW
  COOLDOWN
}

/// Controls pacing only (tick counts per phase) — not which mechanisms run.
enum DemoIntensity {
  LOW
  MEDIUM
  HIGH
}

enum IncidentStatus {
  OPEN
  ACKNOWLEDGED
  MITIGATED
  RESOLVED
  CLOSED
}

enum RcaStatus {
  DRAFT
  IN_REVIEW
  APPROVED
}

enum RunbookOutcome {
  /// Linked to an incident but not executed yet — the state a "link this
  /// runbook to the incident" action leaves it in, before anyone records
  /// how it went.
  PENDING
  SUCCESS
  FAILURE
  PARTIAL
}

enum RunbookCategory {
  DATABASE
  INFRASTRUCTURE
  APPLICATION
  SECURITY
  MONITORING
}

enum SlaWindow {
  DAILY
  WEEKLY
  MONTHLY
}

/// The classic incident-postmortem taxonomy — broad enough to categorize
/// almost any root cause without needing a free-text field for the axis
/// a dashboard actually wants to group and count by.
enum RcaRootCauseCategory {
  HUMAN_ERROR
  CONFIGURATION_CHANGE
  CODE_DEFECT
  INFRASTRUCTURE_FAILURE
  THIRD_PARTY_DEPENDENCY
  CAPACITY_LIMIT
  PROCESS_GAP
}

/// Corrective = fixes this occurrence. Preventive = stops it recurring.
/// The same CorrectiveAction table holds both — they share every other
/// field (description, owner, due date, completion) and only differ in
/// intent, which doesn't justify a second table.
enum CorrectiveActionType {
  CORRECTIVE
  PREVENTIVE
}

/// System-generated entries in an incident's narrative feed. Comments are a
/// separate, user-editable model (see IncidentComment) but are interleaved
/// with these at read time — see IncidentsService.getTimeline.
enum TimelineEventType {
  CREATED
  SEVERITY_CHANGED
  ASSIGNED
  ACKNOWLEDGED
  MITIGATED
  RESOLVED
  REOPENED
  CLOSED
  ESCALATED
}

// ---------------------------------------------------------------------------
// Identity
// ---------------------------------------------------------------------------

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  passwordHash String
  role         UserRole  @default(VIEWER)
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  commandedIncidents Incident[]              @relation("IncidentCommander")
  authoredRunbooks   Runbook[]               @relation("RunbookAuthor")
  executedRunbooks   IncidentRunbook[]       @relation("RunbookExecutor")
  authoredRcaReports RcaReport[]             @relation("RcaAuthor")
  reviewedRcaReports RcaReport[]             @relation("RcaReviewer")
  ownedActions       CorrectiveAction[]      @relation("CorrectiveActionOwner")
  timelineEvents     IncidentTimelineEvent[] @relation("TimelineEventActor")
  incidentComments   IncidentComment[]       @relation("IncidentCommentAuthor")
  alertRules         AlertRule[]
  auditLogs          AuditLog[]
  startedSimulations FailureSimulation[]     @relation("FailureSimulationStartedBy")

  @@index([role])
  @@index([isActive])
  @@map("users")
}

// ---------------------------------------------------------------------------
// Service catalog & dependency graph
// ---------------------------------------------------------------------------

model Service {
  id         String        @id @default(cuid())
  name       String        @unique
  slug       String        @unique
  tier       ServiceTier   @default(TIER_2)
  ownerTeam  String
  // Denormalized cache of current status for fast dashboard reads.
  // Source of truth is the most recent Metric/Alert stream; a background
  // job (or the ingest path itself) keeps this column in sync — see
  // "Database Architecture" doc, §Denormalization.
  status     ServiceStatus @default(UNKNOWN)
  // Archival, not deletion: a decommissioned service still has years of
  // Metric/Incident/SlaRecord history a bank must retain. Hard-deleting
  // the Service row would cascade-delete that history (see the Metric/
  // Alert/SlaRecord relations below); archiving just hides it from the
  // active catalog while every historical FK stays intact. Null = active.
  archivedAt DateTime?
  // Free-text regime codes ("PCI_DSS", "SOX", "GDPR"), not an enum — which
  // regimes exist and apply to which services is a compliance-team
  // decision made continuously, not a schema-migration event. A service
  // can carry more than one.
  complianceScope    String[]           @default([])
  dataClassification DataClassification @default(INTERNAL)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  metrics      Metric[]
  alerts       Alert[]
  alertRules   AlertRule[]
  incidents    Incident[]
  slaRecords   SlaRecord[]
  simulations  FailureSimulation[]
  dependsOn    ServiceDependency[] @relation("DependentService")
  dependedOnBy ServiceDependency[] @relation("UpstreamService")

  @@index([tier, status])
  @@index([archivedAt])
  @@map("services")
}

/// Self-referential many-to-many on Service, modeling the runtime dependency
/// graph used for blast-radius analysis ("if X goes down, what else is hit").
model ServiceDependency {
  id                 String         @id @default(cuid())
  serviceId          String
  service            Service        @relation("DependentService", fields: [serviceId], references: [id], onDelete: Cascade)
  dependsOnServiceId String
  dependsOnService   Service        @relation("UpstreamService", fields: [dependsOnServiceId], references: [id], onDelete: Cascade)
  dependencyType     DependencyType @default(HARD)
  createdAt          DateTime       @default(now())

  // NOTE: a CHECK (serviceId <> dependsOnServiceId) constraint is added by
  // raw SQL in the migration — Prisma's schema DSL has no CHECK syntax.
  @@unique([serviceId, dependsOnServiceId])
  @@index([dependsOnServiceId])
  @@map("service_dependencies")
}

// ---------------------------------------------------------------------------
// Telemetry (durable rollups — Prometheus remains system-of-record for raw
// high-frequency samples; see Monitoring Architecture)
// ---------------------------------------------------------------------------

model Metric {
  // BigInt identity, not cuid: this table is the highest-volume, pure
  // append-only table in the schema. A sequential integer PK keeps insert
  // locality and index size far smaller than a UUID/cuid PK would at scale.
  id         BigInt   @id @default(autoincrement())
  serviceId  String
  service    Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  metricName String
  value      Float
  unit       String
  recordedAt DateTime

  // Primary access pattern: "this service's this metric, most recent first".
  @@unique([serviceId, metricName, recordedAt])
  @@index([serviceId, metricName, recordedAt(sort: Desc)])
  @@map("metrics")
}

// ---------------------------------------------------------------------------
// Alerting & incident response
// ---------------------------------------------------------------------------

model Alert {
  id          String     @id @default(cuid())
  serviceId   String
  service     Service    @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  // Nullable + many-to-one: several correlated alerts (an "alert storm")
  // often escalate into a single incident.
  incidentId  String?
  incident    Incident?  @relation(fields: [incidentId], references: [id])
  ruleName    String
  severity    Severity
  state       AlertState @default(FIRING)
  // Alertmanager's dedupe fingerprint for the firing series.
  fingerprint String
  firedAt     DateTime   @default(now())
  resolvedAt  DateTime?
  createdAt   DateTime   @default(now())

  // NOTE: a partial unique index on (serviceId, ruleName) WHERE state =
  // 'FIRING' is added by raw SQL in the migration, so the same rule can
  // never have two simultaneously-open alerts for one service — Prisma's
  // schema DSL has no partial/filtered index syntax.
  @@index([serviceId, firedAt(sort: Desc)])
  @@index([incidentId])
  @@index([state, severity])
  @@map("alerts")
}

/// Threshold configuration the alert engine evaluates against every metric
/// sample recorded for (serviceId, metricName). At most one rule per pair —
/// realistic alerting systems support multiple rules per metric (different
/// windows, different comparators), but one rule with four severity tiers
/// covers this platform's actual need without the added complexity of a
/// rule-priority/conflict-resolution scheme.
model AlertRule {
  id                String          @id @default(cuid())
  serviceId         String
  service           Service         @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  metricName        String
  comparator        AlertComparator
  // Evaluated most-severe first. Any may be null — a rule doesn't have to
  // define all four tiers (e.g. a rule with only criticalThreshold set
  // never fires SEV2-4).
  criticalThreshold Float?
  highThreshold     Float?
  mediumThreshold   Float?
  lowThreshold      Float?
  // Free-text against RemediationEngine's REMEDIATION_ACTIONS (validated at
  // the zod boundary, not an enum) — same reasoning as AuditLog.action: a
  // new remediation action type ships as application code, not a schema
  // migration. Null = no auto-remediation for this rule (the default —
  // this is opt-in per rule, not a platform-wide behavior). Only ever
  // consulted for a SEV1 (criticalThreshold-driven) firing transition; see
  // AlertsService.evaluateMetric.
  autoRemediateAction String?
  isActive          Boolean         @default(true)
  createdById       String
  createdBy         User            @relation(fields: [createdById], references: [id])
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@unique([serviceId, metricName])
  @@index([isActive])
  @@map("alert_rules")
}

/// A running (or finished) chaos-engineering fault injection against one
/// service. `stoppedAt` null means running — the same "timestamp instead
/// of a boolean" pattern as Service.archivedAt, for the same reason: it
/// records *when*, not just *whether*. The simulation tick loop (see
/// server.ts) advances `tickCount` and feeds synthetic Metric samples
/// through the normal recording path for every running row, so the
/// already-built AlertsService reacts to injected faults exactly as it
/// would to a real one — no separate alert-generation code path here.
model FailureSimulation {
  id          String          @id @default(cuid())
  serviceId   String
  service     Service         @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  scenario    FailureScenario
  tickCount   Int             @default(0)
  startedById String
  startedBy   User            @relation("FailureSimulationStartedBy", fields: [startedById], references: [id])
  startedAt   DateTime        @default(now())
  stoppedAt   DateTime?

  @@index([serviceId])
  @@index([stoppedAt])
  @@map("failure_simulations")
}

/// Singleton row (id is always the literal "singleton") holding the one
/// currently-running (or idle) Demo Mode run. Deliberately plain scalar
/// columns, no Prisma relations, to the service/incident/RCA it references —
/// this table is orchestration state for DemoModeService, not a domain
/// entity anything else joins against. See modules/demo-mode for the state
/// machine that reads and writes it every scheduler tick.
model DemoModeState {
  id               String         @id @default("singleton")
  enabled          Boolean        @default(false)
  autoLoop         Boolean        @default(true)
  intensity        DemoIntensity  @default(MEDIUM)
  phase            DemoPhase      @default(IDLE)
  scenario         DemoScenario?
  lastScenario     DemoScenario?
  serviceId        String?
  incidentId       String?
  alertId          String?
  rcaReportId      String?
  phaseStartedAt   DateTime?
  ticksInPhase     Int            @default(0)
  phaseTargetTicks Int            @default(0)
  startedById      String?
  startedAt        DateTime?
  updatedAt        DateTime       @updatedAt

  @@map("demo_mode_state")
}

model Incident {
  id                String         @id @default(cuid())
  title             String
  severity          Severity
  status            IncidentStatus @default(OPEN)
  primaryServiceId  String
  primaryService    Service        @relation(fields: [primaryServiceId], references: [id])
  commanderId       String?
  commander         User?          @relation("IncidentCommander", fields: [commanderId], references: [id])
  openedAt          DateTime       @default(now())
  acknowledgedAt    DateTime?
  resolvedAt        DateTime?
  closedAt          DateTime?
  // Free-text summary captured at resolve() — "what fixed it", distinct
  // from the full RcaReport's root-cause analysis which is written later
  // (and, for P1/P2, required before the incident can be closed).
  resolutionSummary String?
  // Real incidents accumulate links to every other tool a response
  // actually happens in — nullable free text, not a foreign key, because
  // the ticket/status-page system is external and this platform has no
  // way to validate a URL against it.
  externalTicketUrl String?
  statusPageUrl     String?
  // How far up the severity's escalation chain this incident has climbed,
  // and when that last happened — the state the EscalationEngine reads to
  // decide whether the *next* sweep should escalate it further.
  escalationLevel   Int            @default(0)
  lastEscalatedAt   DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  alerts         Alert[]
  runbookRuns    IncidentRunbook[]
  rcaReport      RcaReport?
  timelineEvents IncidentTimelineEvent[]
  comments       IncidentComment[]

  @@index([status, severity])
  @@index([primaryServiceId, openedAt(sort: Desc)])
  @@index([commanderId])
  @@map("incidents")
}

/// The system-generated narrative of an incident: one row per meaningful
/// state change (created, escalated, acknowledged, ...). Immutable by
/// convention (nothing in the service layer updates or deletes these) —
/// it's the incident-scoped equivalent of AuditLog, kept separate because
/// AuditLog is a platform-wide compliance trail across every entity while
/// this is what an incident-detail screen renders as a timeline.
model IncidentTimelineEvent {
  id         String            @id @default(cuid())
  incidentId String
  incident   Incident          @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  type       TimelineEventType
  message    String
  // Null for system/automated entries (e.g. an escalation the sweep made).
  actorId    String?
  actor      User?             @relation("TimelineEventActor", fields: [actorId], references: [id])
  metadata   Json?
  createdAt  DateTime          @default(now())

  @@index([incidentId, createdAt])
  @@map("incident_timeline_events")
}

/// User-authored discussion on an incident — separate from
/// IncidentTimelineEvent because comments are edited/owned by a person,
/// while timeline events are an immutable system record. The two are
/// merged into one chronological feed at read time, not at the storage
/// layer.
model IncidentComment {
  id         String   @id @default(cuid())
  incidentId String
  incident   Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  authorId   String
  author     User     @relation("IncidentCommentAuthor", fields: [authorId], references: [id])
  body       String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([incidentId, createdAt])
  @@map("incident_comments")
}

// ---------------------------------------------------------------------------
// Runbooks & their execution history
// ---------------------------------------------------------------------------

model Runbook {
  id               String          @id @default(cuid())
  title            String
  slug             String          @unique
  category         RunbookCategory @default(INFRASTRUCTURE)
  triggerCondition String
  // Ordered steps consumed atomically by the UI renderer and the
  // remediation engine alike — read as one document, never queried
  // piecemeal, which is the legitimate case for JSONB over decomposition.
  steps            Json
  // Bumped on every edit. Executions snapshot the version they ran so a
  // later edit to the runbook never rewrites incident history.
  version          Int             @default(1)
  isActive         Boolean         @default(true)
  createdById      String
  createdBy        User            @relation("RunbookAuthor", fields: [createdById], references: [id])
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  executions IncidentRunbook[]

  @@index([isActive])
  @@index([category])
  @@map("runbooks")
}

/// Join table for the many-to-many between Incident and Runbook, carrying
/// execution metadata. This table isn't one of the ten named entities, but
/// a plain M:N join would lose exactly the data an audit needs: which
/// runbook VERSION ran, who ran it (or that it was automatic), and whether
/// it worked.
model IncidentRunbook {
  id                    String         @id @default(cuid())
  incidentId            String
  incident              Incident       @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  runbookId             String
  runbook               Runbook        @relation(fields: [runbookId], references: [id])
  runbookVersion        Int
  executedById          String?
  executedBy            User?          @relation("RunbookExecutor", fields: [executedById], references: [id])
  executedAutomatically Boolean        @default(false)
  outcome               RunbookOutcome
  executedAt            DateTime       @default(now())

  @@index([incidentId])
  @@index([runbookId])
  @@map("incident_runbooks")
}

// ---------------------------------------------------------------------------
// Root cause analysis
// ---------------------------------------------------------------------------

model RcaReport {
  id                  String               @id @default(cuid())
  incidentId          String               @unique
  incident            Incident             @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  rootCause           String
  rootCauseCategory   RcaRootCauseCategory @default(PROCESS_GAP)
  contributingFactors String?
  authoredById        String
  authoredBy          User                 @relation("RcaAuthor", fields: [authoredById], references: [id])
  // Four-eyes principle: a banking RCA is reviewed by someone other than
  // its author before it's considered final.
  reviewedById        String?
  reviewedBy          User?                @relation("RcaReviewer", fields: [reviewedById], references: [id])
  status              RcaStatus            @default(DRAFT)
  publishedAt         DateTime?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  correctiveActions CorrectiveAction[]

  @@index([status])
  @@map("rca_reports")
}

/// One-to-many child of RcaReport. Splitting corrective actions out of a
/// JSONB blob (the obvious alternative) is what makes "list every open
/// corrective action across all RCAs, by owner" a plain indexed query
/// instead of a JSONB scan across every report.
model CorrectiveAction {
  id          String               @id @default(cuid())
  rcaReportId String
  rcaReport   RcaReport            @relation(fields: [rcaReportId], references: [id], onDelete: Cascade)
  type        CorrectiveActionType @default(CORRECTIVE)
  description String
  ownerId     String
  owner       User                 @relation("CorrectiveActionOwner", fields: [ownerId], references: [id])
  dueDate     DateTime?
  isComplete  Boolean              @default(false)
  createdAt   DateTime             @default(now())

  @@index([rcaReportId])
  @@index([ownerId, isComplete])
  @@map("corrective_actions")
}

// ---------------------------------------------------------------------------
// SLA / error-budget reporting (materialized rollup, recomputed on schedule)
// ---------------------------------------------------------------------------

model SlaRecord {
  id                         String    @id @default(cuid())
  serviceId                  String
  service                    Service   @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  windowType                 SlaWindow
  windowStart                DateTime
  windowEnd                  DateTime
  targetPercent              Decimal   @db.Decimal(5, 2)
  actualPercent              Decimal   @db.Decimal(5, 2)
  errorBudgetMinutes         Decimal   @db.Decimal(10, 2)
  errorBudgetConsumedMinutes Decimal   @db.Decimal(10, 2)
  // Response time: average of this service's own latency metric samples
  // in the window (see Metric). Nullable — a service reporting no
  // latency metric in the window has no response-time figure, not zero.
  avgResponseTimeMs          Decimal?  @db.Decimal(10, 2)
  // Mean Time To Detect: average gap between an alert firing and the
  // incident it correlated to being created. Nullable — a window with no
  // incidents has nothing to average.
  meanTimeToDetectMinutes    Decimal?  @db.Decimal(10, 2)
  // Mean Time To Recover: average of (resolvedAt - openedAt) across
  // incidents resolved in the window. Same nullability reasoning.
  meanTimeToRecoverMinutes   Decimal?  @db.Decimal(10, 2)
  // Computed by the SlaCalculator service at write time (actualPercent <
  // targetPercent), not a DB-generated column — kept as a plain column so
  // it stays queryable/indexable without relying on Postgres GENERATED
  // ALWAYS AS semantics, which Prisma's client cannot express type-safely.
  breached                   Boolean   @default(false)
  calculatedAt               DateTime  @default(now())

  @@unique([serviceId, windowType, windowStart])
  @@index([serviceId, windowType, windowStart(sort: Desc)])
  @@index([breached])
  @@map("sla_records")
}

// ---------------------------------------------------------------------------
// Audit trail — append-only, immutable, attributable to a real actor
// ---------------------------------------------------------------------------

model AuditLog {
  // BigInt identity for the same reason as Metric: this table is written
  // on every state-changing action platform-wide and is never updated or
  // deleted, so insert throughput and index compactness matter more than
  // global ID generation without a DB round trip.
  id          BigInt   @id @default(autoincrement())
  // NOT NULL and always a real User row (including a reserved system
  // service-account user for automated actions) — every audited action in
  // a banking system must be attributable to someone, never a nullable FK.
  actorId     String
  actor       User     @relation(fields: [actorId], references: [id])
  // Free-text action code (e.g. "incident.resolve", "runbook.execute"),
  // not an enum: new action types are added by shipping application code,
  // not by running a schema migration.
  action      String
  entityType  String
  // Intentionally not a foreign key: this is a polymorphic reference
  // (entityType names the table), and audit rows must outlive the rows
  // they describe if the source entity is ever purged under a retention
  // policy. Enforced by application code, not the database.
  entityId    String?
  beforeState Json?
  afterState  Json?
  ipAddress   String?
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([entityType, entityId])
  @@index([actorId, createdAt(sort: Desc)])
  @@index([createdAt])
  @@map("audit_logs")
}
